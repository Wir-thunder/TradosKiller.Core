<Window x:Class="TradosKiller.Core.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trados Killer Engine v0.1" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Button Content="📂 Abrir" Width="80" Height="30" Margin="0,0,10,0" Click="btnOpen_Click"/>
            <Button Content="💾 Salvar" Width="80" Height="30" Margin="0,0,20,0" Click="btnSave_Click"/>
            
            <Label Content="🔍 Filtrar:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtFilter" Width="300" Height="25" VerticalContentAlignment="Center" 
                     TextChanged="txtFilter_TextChanged" />
        </StackPanel>

        <DataGrid x:Name="dgSegments" 
                  Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  AlternatingRowBackground="#F9F9F9"
                  CanUserAddRows="False"
                  EnableRowVirtualization="True"
                  SelectionMode="Single"
                  PreviewKeyDown="dgSegments_PreviewKeyDown">
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="80"/>
                
                <DataGridTextColumn Header="Source (Original)" Binding="{Binding Source}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Target (Tradução)" Binding="{Binding Target}" Width="*" Foreground="Blue">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>